{
  "name": "nocturne-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "author": "NOCTURNE",
  "description": "Nocturne — a frameless, always-on-top dark desktop widget.",
  "scripts": {
    "start": "node server.mjs",
    "widget": "wscript scripts\\start-widget.vbs",
    "autostart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-autostart.ps1",
    "autostart:remove": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/remove-autostart.ps1",
    "dist": "electron-builder --win nsis --x64",
    "dist:dir": "electron-builder --win dir --x64",
    "test": "node tests/e2e.mjs",
    "test:widget": "node tests/electron-e2e.mjs",
    "test:widget-browser": "node tests/widget-e2e.mjs",
    "test:all": "node tests/e2e.mjs && node tests/widget-e2e.mjs && node tests/electron-e2e.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  }
}
